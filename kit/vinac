#!/bin/sh
# Run VINAC Link commands from this folder (macOS, Linux), e.g.:  ./vinac send-file report.pdf --to "Office PC"
D="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"   # follows a link (e.g. ~/.local/bin/vinac)
for d in "node/bin" "node/$(uname -m | sed s/x86_64/x64/)/bin"; do [ -x "$D/$d/node" ] && PATH="$D/$d:$PATH"; done
exec node "$D/connector/bin/vinac.mjs" "$@"
